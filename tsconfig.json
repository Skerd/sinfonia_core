{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "vite/client"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@coreModule/*": ["src/modules/core/*"],
      "@eCommerceModule/*": ["src/modules/eCommerce/*"],
      "@eCommerceMarketplaceModule/*": ["src/modules/eCommerceMarketplace/*"],
      "@financeModule/*": ["src/modules/finance/*"],
      "@musicIndustryModule/*": ["src/modules/musicIndustry/*"],
      "@propertyManagementModule/*": ["src/modules/propertyManagement/*"],
      "@swissOutreachModule/*": ["src/modules/swissOutreach/*"],
      "armonia/*": ["../armonia/*"],
      "@/*": ["src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/modules/core/components/uiKit"
  ]
}
